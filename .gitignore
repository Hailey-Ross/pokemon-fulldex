/build/
/build-*/
# The Google sign-in client for cloud saves (an id, then its secret): never commit.
fulldex-google-client.txt
# The Android build: downloaded NDK and SDL2, the signing key, and the APK, which
# contains the game (tools/android/skeleton.apk does not, and is kept).
/android/
/*.apk

+// Widescreen, set once per frame: drawn only while the game keeps asking (register 0x5E, see above)
+static void _wideLatch(struct GBAVideoSoftwareRenderer* softwareRenderer) {
+	int extra = softwareRenderer->d.wideExtra;
+	if (extra < 0) {
+		extra = 0;
+	} else if (extra > GBA_VIDEO_WIDE_MAX_EXTRA) {
+		extra = GBA_VIDEO_WIDE_MAX_EXTRA;
+	}
+	int active = 0;
+	uint8_t mask = 0;
+	if (extra && softwareRenderer->wideSignal > 0) {
+		--softwareRenderer->wideSignal;
+		active = extra;
+		mask = softwareRenderer->wideMaskNext;
+	}
+	if (extra == softwareRenderer->wideExtra && active == softwareRenderer->wideActive && mask == softwareRenderer->wideMask) {
+		return;
+	}
+	softwareRenderer->wideExtra = extra;
+	softwareRenderer->wideActive = active;
+	softwareRenderer->wideMask = mask;
+	softwareRenderer->wideWidth = GBA_VIDEO_HORIZONTAL_PIXELS + 2 * active;
+	softwareRenderer->oamDirty = 1;
+	memset(softwareRenderer->scanlineDirty, 0xFFFFFFFF, sizeof(softwareRenderer->scanlineDirty));
+}
+
+// Layers the game didn't mark wide (bits 0-3 backgrounds, 4 sprites) stay in the centre 240 columns
+static bool _wideClip(struct GBAVideoSoftwareRenderer* softwareRenderer, int layer, int start, int end) {
+	int wide = softwareRenderer->wideActive;
+	if (wide && !(softwareRenderer->wideMask & (1 << layer))) {
+		if (start < wide) {
+			start = wide;
+		}
+		if (end > wide + GBA_VIDEO_HORIZONTAL_PIXELS) {
+			end = wide + GBA_VIDEO_HORIZONTAL_PIXELS;
+		}
+	}
+	softwareRenderer->start = start;
+	softwareRenderer->end = end;
+	return start < end;
+}
